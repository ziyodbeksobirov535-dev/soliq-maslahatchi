# Nusxa oling: cp .env.example .env  — .env git'ga tushmaydi.

TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Model ID'lari faqat shu yerda. PHASE 4 da Anthropic docs bo'yicha qayta tekshiriladi.
ANTHROPIC_MAIN_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# Ixtiyoriy: low | medium | high | xhigh | max (bo'sh = model sukuti)
ANTHROPIC_EFFORT=
ANTHROPIC_MAX_TOKENS=16000
# Server-side refusal fallback: default | off
ANTHROPIC_REFUSAL_FALLBACK=default

SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vergul bilan: 123456789,987654321
ADMIN_TELEGRAM_IDS=
DAILY_QUESTION_LIMIT=20
TIMEZONE=Asia/Tashkent

LEXUZ_DELAY_SECONDS=1.5
LEXUZ_MAX_RETRIES=5
LEXUZ_TIMEOUT_SECONDS=30
LEXUZ_CACHE_DIR=.cache/lexuz
LEXUZ_CACHE_TTL_HOURS=24
# Lex.uz qidiruvida topilgan amaldagi eski hujjatlar: kunlik import limiti (0 = o'chiq; 50 ≈ 20 kunda ~1 000 hujjat)
DISCOVERY_DAILY_LIMIT=50
# Yangilik/o'zgarish xabarlari (admin tasdig'idan keyin) faqat shu soatlarda yuboriladi, mahalliy vaqt
NEWS_SEND_START_HOUR=9
NEWS_SEND_END_HOUR=20
# Shundan eski RSS yangiliklari uchun xabar tayyorlanmaydi (kun)
NEWS_MAX_AGE_DAYS=3
# Botdan foydalanish uchun majburiy kanal: @kanal_nomi yoki -100... (bo'sh = o'chiq). Bot kanalda admin bo'lishi shart.
REQUIRED_CHANNEL=
# Kanal taklif havolasi (yopiq kanal uchun); bo'sh bo'lsa @kanal_nomi dan olinadi
REQUIRED_CHANNEL_URL=
# Admin tasdiqlagan yangiliklar shu kanalga ham joylanadi (@kanal yoki -100...; bo'sh = yo'q). Bot kanalda admin.
NEWS_CHANNEL=
# Obuna (premium): kunlik limit, narx (so'm), muddat (kun). Narx 0 yoki token bo'sh — obunani admin beradi (/obuna_ber)
PREMIUM_DAILY_LIMIT=100
PREMIUM_PRICE_UZS=0
PREMIUM_DAYS=30
# @BotFather → Payments → Click yoki Payme provider tokeni (maxfiy, git'ga tushmaydi)
PAYMENT_PROVIDER_TOKEN=
# Token bo'lmasa to'lov uchun aloqa, masalan: @admin_username
PAYMENT_CONTACT=

LOG_LEVEL=INFO
